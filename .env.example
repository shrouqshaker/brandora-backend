DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brandora?schema=public"
PORT=3000
IMPORT_STORAGE_DIR=".storage/imports"
JWT_SECRET=
JWT_ISSUER="brandora"
JWT_AUDIENCE="brandora-android"
AUTH_RATE_LIMIT_SECRET=
# Leave empty until an authenticated/isolated proxy boundary is verified.
# Railway has no stable proxy CIDR allowlist; see docs/railway-proxy-security.md.
AUTH_TRUSTED_PROXY_CIDRS=
# Brevo HTTPS API; set AUTH_EMAIL_MODE=brevo after configuring it manually.
AUTH_EMAIL_MODE="disabled"
# Inject the API key privately through the environment.
BREVO_API_KEY=
# Bare email address, verified as a sender in Brevo; authenticate its domain.
BREVO_SENDER_EMAIL=

# Product image uploads remain unavailable until these are configured privately.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# WhatsApp Cloud API (Meta). Stays "false" until the webhook is tested end to end.
WHATSAPP_ENABLED="false"
# A long random word you choose (16+ characters, no spaces). Type the same word in Meta.
WHATSAPP_VERIFY_TOKEN=
# Meta App secret (App settings > Basic). Signs every webhook. Never commit it.
WHATSAPP_APP_SECRET=
# Token that lets the backend send messages for the business number. Never commit it.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION="v26.0"
# Anything except "false" writes replies to the log instead of sending them to Meta.
WHATSAPP_DRY_RUN="true"