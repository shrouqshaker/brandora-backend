DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brandora?schema=public"
PORT=3000
IMPORT_STORAGE_DIR=".storage/imports"
JWT_SECRET=
JWT_ISSUER="brandora"
JWT_AUDIENCE="brandora-android"
AUTH_RATE_LIMIT_SECRET=
# Leave empty until an authenticated/isolated proxy boundary is verified.
# Railway has no stable proxy CIDR allowlist; see docs/railway-proxy-security.md.
AUTH_TRUSTED_PROXY_CIDRS=
# Resend development SMTP; disabled until the owner configures it manually.
AUTH_EMAIL_MODE="disabled"
# Placeholder only: replace for a working Android HTTPS App Link.
AUTH_RESET_URL="https://reset.example.invalid/auth/reset-password"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
# Inject a NEW key locally as SMTP_PASSWORD. Never reuse the compromised key.
SMTP_PASSWORD=
# Development only: recipient must be the email on the Resend account.
SMTP_FROM="onboarding@resend.dev"
