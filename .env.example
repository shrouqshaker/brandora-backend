# Brandora AI - local test configuration. Copy to .env.local and fill in. NEVER commit .env.local.
# Run:  python -m app.local --env-file .env.local        (loopback only, APP_ENV must be local)
# Generate the three secrets below with:  python tools/gen_dev_keys.py

APP_ENV=local
AI_LOCAL_ENABLED=true
AI_LOCAL_PORT=8000

# rules = deterministic only, no model call.  groq = real GroqCloud LLM (needs GROQ_API_KEY).
AI_LOCAL_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b
# Groq budgets (seconds). gpt-oss-120b is a reasoning model, so 3s/8s was too tight. The code now enforces >=20/30 for `python -m app.chat`.
# GROQ_REASONING_EFFORT=low   # low|medium|high (gpt-oss only); low = fastest
CHAT_PROVIDER_TIMEOUT_SECONDS=20
CHAT_TOTAL_TIMEOUT_SECONDS=30

# Where the NestJS Backend (connected to Neon) listens. Must be loopback in local mode.
BACKEND_BASE_URL=http://127.0.0.1:3000

# Backend -> AI credential (Backend's AI_SERVICE_TOKEN). >= 32 printable chars.
AI_SERVICE_TOKEN=
# AI -> Backend credential (Backend's BACKEND_SERVICE_TOKEN). Must differ from the one above.
BACKEND_SERVICE_TOKEN=
# RSA PUBLIC key (one line, newlines written as \n) matching the Backend's AI_CONTEXT_PRIVATE_KEY.
BACKEND_CONTEXT_PUBLIC_KEY=

# Optional
LOG_LEVEL=INFO
# STOCK_QUANTITY_DISCLOSURE_BUSINESSES=<business-uuid>,<business-uuid>   # businesses allowed to reveal exact stock numbers

# ---- Staging / production (Railway) only, via python -m app.server ----
# APP_ENV=staging|production
# AI_INTEGRATION_ENABLED=true
# BACKEND_BASE_URL=https://<backend-domain>
# TRUSTED_PROXY_CIDRS=<explicit verified CIDRs, never 0.0.0.0/0>
# Alternatively, for an isolated Railway environment with no TCP proxy:
# RAILWAY_EDGE_HTTPS_ENABLED=true
# Leave TRUSTED_PROXY_CIDRS unset in this mode. Railway injects RAILWAY_PUBLIC_DOMAIN,
# RAILWAY_PROJECT_ID, RAILWAY_ENVIRONMENT_ID and RAILWAY_SERVICE_ID.
# Trust all services in that environment; never use this mode with untrusted peers.
# PORT is supplied by Railway.
