{
  "info": {
    "name": "Brandora — Customers & Conversations",
    "_postman_id": "6b1f3f0e-7c2a-4d51-9b8e-2f6c1c9a0d11",
    "description": "Owner APIs for customers, conversations and messages (customers, conversations and the WhatsApp number). Run Auth → Login, then Business → Pick first business. Examples were captured from the real application on a disposable local database. No real tokens or secrets are stored here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "owner@example.test"
    },
    {
      "key": "password",
      "value": "ChangeMe-Local-123!"
    },
    {
      "key": "token",
      "value": ""
    },
