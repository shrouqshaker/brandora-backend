generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(200)
  description        String?
  category           String?             @db.VarChar(200)
  phone              String?             @db.VarChar(50)
  address            String?             @db.VarChar(1000)
  settings           BusinessSettings?
  workingHours       WorkingHour[]
  catalogItems       CatalogItem[]
  categories         Category[]
  productVariants    ProductVariant[]
  importJobs         ImportJob[]
  inventoryMovements InventoryMovement[]
  memberships        BusinessMember[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id            String              @id @default(uuid()) @db.Uuid
  email         String              @unique @db.VarChar(254)
  passwordHash  String
  authVersion   Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  memberships   BusinessMember[]
  sessions      AuthSession[]
  passwordReset PasswordResetToken?
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenFamilyId    String    @unique @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  usedTokenHashes  String[]  @default([])
  rotationCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?

  @@index([userId, revokedAt, expiresAt])
}

model PasswordResetToken {
  userId         String    @id @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash      String    @unique @db.Char(64)
  authVersion    Int
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?
  deliveryStatus String    @default("PENDING") @db.VarChar(10)

  @@index([expiresAt])
}

model AuthRateBucket {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.Char(64)
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum BusinessRole {
  OWNER
}

model BusinessMember {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  businessId String       @db.Uuid
  role       BusinessRole @default(OWNER)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([userId, businessId])
  @@index([businessId])
}

model BusinessSettings {
  businessId           String   @id @db.Uuid
  business             Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  acceptsCash          Boolean  @default(true)
  acceptsOnlinePayment Boolean  @default(false)
  deliveryEnabled      Boolean  @default(false)
  pickupEnabled        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model WorkingHour {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  dayOfWeek  DayOfWeek
  isOpen     Boolean
  opensAt    String?   @db.VarChar(5)
  closesAt   String?   @db.VarChar(5)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model CatalogItem {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  externalKey        String?             @db.VarChar(200)
  name               String              @db.VarChar(200)
  description        String?
  category           String?             @db.VarChar(200)
  categoryId         String?             @db.Uuid
  categoryRecord     Category?           @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  options            Json                @default("{}") @db.JsonB
  basePrice          Decimal?            @db.Decimal(12, 2)
  trackInventory     Boolean             @default(false)
  stockQuantity      Int?
  attributes         Json?               @db.JsonB
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  variants           ProductVariant[]

  @@unique([businessId, externalKey])
  // Additive tenant key for the ProductVariant composite foreign key.
  @@unique([businessId, id])
  @@index([businessId, categoryId])
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, createdAt])
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  businessId   String        @db.Uuid
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Normalized name uniqueness and nonblank validation live in migration SQL.
  name         String        @db.VarChar(200)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  catalogItems CatalogItem[]

  @@unique([businessId, id])
  @@index([businessId])
}

model ProductVariant {
  id             String      @id @default(uuid()) @db.Uuid
  businessId     String      @db.Uuid
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  catalogItemId  String      @db.Uuid
  catalogItem    CatalogItem @relation(fields: [businessId, catalogItemId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  sku            String?     @db.VarChar(200)
  optionValues   Json        @default("{}") @db.JsonB
  unitPrice      Decimal?    @db.Decimal(12, 2)
  trackInventory Boolean     @default(false)
  stockQuantity  Int?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // PostgreSQL permits multiple NULL SKUs; inactive rows retain their SKU.
  @@unique([businessId, sku])
  // JSONB equality ignores object key order; inactive combinations stay reserved.
  @@unique([businessId, catalogItemId, optionValues], map: "ProductVariant_parent_optionValues_key")
  @@index([businessId])
  @@index([catalogItemId])
  @@index([businessId, catalogItemId])
}

enum ImportJobStatus {
  UPLOADED
  ANALYZING
  MAPPING_REQUIRED
  VALIDATING
  READY
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ImportSourceType {
  EXCEL
}

enum InventoryMovementType {
  INITIAL_IMPORT
  IMPORT_UPDATE
  MANUAL_ADJUSTMENT
  ORDER_APPROVED
  ORDER_CANCELLED
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  businessId     String                @db.Uuid
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  catalogItemId  String                @db.Uuid
  catalogItem    CatalogItem           @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  type           InventoryMovementType
  quantityBefore Int?
  quantityAfter  Int
  quantityDelta  Int
  referenceType  String?               @db.VarChar(50)
  referenceId    String?               @db.VarChar(200)
  createdAt      DateTime              @default(now())

  @@index([businessId, createdAt])
  @@index([catalogItemId, createdAt])
  @@index([businessId, referenceType, referenceId])
}

model ImportJob {
  id            String           @id @default(uuid()) @db.Uuid
  businessId    String           @db.Uuid
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  status        ImportJobStatus  @default(UPLOADED)
  sourceType    ImportSourceType @default(EXCEL)
  fileName      String
  fileKey       String?
  sheetName     String?
  headerRow     Int?
  mapping       Json?            @db.JsonB
  errors        Json?            @db.JsonB
  totalRows     Int              @default(0)
  validRows     Int              @default(0)
  invalidRows   Int              @default(0)
  skippedRows   Int              @default(0)
  insertedCount Int              @default(0)
  updatedCount  Int              @default(0)
  failedCount   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
}
