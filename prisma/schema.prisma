generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(200)
  description        String?
  category           String?             @db.VarChar(200)
  phone              String?             @db.VarChar(50)
  address            String?             @db.VarChar(1000)
  settings           BusinessSettings?
  workingHours       WorkingHour[]
  products           Product[]
  categories         Category[]
  productVariants    ProductVariant[]
  importJobs         ImportJob[]
  inventoryMovements InventoryMovement[]
  memberships        BusinessMember[]
  customers          Customer[]
  conversations      Conversation[]
  messages           Message[]
  whatsappConnection WhatsAppConnection?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id            String              @id @default(uuid()) @db.Uuid
  email         String              @unique @db.VarChar(254)
  passwordHash  String
  authVersion   Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  memberships   BusinessMember[]
  sessions      AuthSession[]
  passwordReset PasswordResetToken?
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenFamilyId    String    @unique @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  usedTokenHashes  String[]  @default([])
  rotationCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?

  @@index([userId, revokedAt, expiresAt])
}

model PasswordResetToken {
  userId         String    @id @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash      String    @unique @db.Char(64)
  authVersion    Int
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?
  deliveryStatus String    @default("PENDING") @db.VarChar(10)

  @@index([expiresAt])
}

model AuthRateBucket {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.Char(64)
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum BusinessRole {
  OWNER
}

model BusinessMember {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  businessId String       @db.Uuid
  role       BusinessRole @default(OWNER)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([userId, businessId])
  @@index([businessId])
}

model BusinessSettings {
  businessId           String   @id @db.Uuid
  business             Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  acceptsCash          Boolean  @default(true)
  acceptsOnlinePayment Boolean  @default(false)
  deliveryEnabled      Boolean  @default(false)
  pickupEnabled        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model WorkingHour {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  dayOfWeek  DayOfWeek
  isOpen     Boolean
  opensAt    String?   @db.VarChar(5)
  closesAt   String?   @db.VarChar(5)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  externalKey        String?             @db.VarChar(200)
  name               String              @db.VarChar(200)
  description        String?
  category           String?             @db.VarChar(200)
  categoryId         String?             @db.Uuid
  categoryRecord     Category?           @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  options            Json                @default("{}") @db.JsonB
  colorOptionName    String?             @db.VarChar(60)
  basePrice          Decimal?            @db.Decimal(12, 2)
  attributes         Json?               @db.JsonB
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  variants           ProductVariant[]
  images             ProductImage[]

  @@unique([businessId, externalKey])
  // Additive tenant key for the ProductVariant composite foreign key.
  @@unique([businessId, id])
  @@index([businessId, categoryId])
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, createdAt])
}

// Upload reservations and deletion tombstones retain public IDs for manual recovery.
// SQL partial indexes permit one ACTIVE main image and one per color slot.
model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  publicId    String   @unique @db.VarChar(250)
  secureUrl   String?  @db.VarChar(1000)
  optionName  String?  @db.VarChar(60)
  optionValue String?  @db.VarChar(100)
  status      String   @default("UPLOADING") @db.VarChar(20)
  // Active images occupy compact slots 0..4; slot 0 is the Main Image.
  position    Int      @default(0)
  width       Int?
  height      Int?
  bytes       Int?
  format      String?  @db.VarChar(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, productId, status])
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Normalized name uniqueness and nonblank validation live in migration SQL.
  name       String    @db.VarChar(200)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@unique([businessId, id])
  @@index([businessId])
}

model ProductVariant {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId          String              @db.Uuid
  product            Product             @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  sku                String?             @db.VarChar(200)
  optionValues       Json                @default("{}") @db.JsonB
  unitPrice          Decimal?            @db.Decimal(12, 2)
  trackInventory     Boolean             @default(false)
  stockQuantity      Int?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]

  // PostgreSQL permits multiple NULL SKUs; inactive rows retain their SKU.
  @@unique([businessId, productId, id])
  @@unique([businessId, sku])
  // JSONB equality ignores object key order; inactive combinations stay reserved.
  @@unique([businessId, productId, optionValues], map: "ProductVariant_parent_optionValues_key")
  @@index([businessId])
  @@index([productId])
  @@index([businessId, productId])
}

enum ImportJobStatus {
  UPLOADED
  ANALYZING
  MAPPING_REQUIRED
  VALIDATING
  READY
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ImportSourceType {
  EXCEL
}

enum InventoryMovementType {
  INITIAL_IMPORT
  IMPORT_UPDATE
  MANUAL_ADJUSTMENT
  ORDER_APPROVED
  ORDER_CANCELLED
}

model InventoryMovement {
  // SQL-only partial uniqueness reserves each ORDER_LINE per business/type.
  id                String                @id @default(uuid()) @db.Uuid
  businessId        String                @db.Uuid
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId         String                @db.Uuid
  product           Product               @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  variantId         String                @db.Uuid
  variant           ProductVariant        @relation(fields: [businessId, productId, variantId], references: [businessId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  type              InventoryMovementType
  quantityBefore    Int?
  quantityAfter     Int?
  quantityDelta     Int
  trackingBefore    Boolean
  trackingAfter     Boolean
  requestedQuantity Int?
  referenceType     String?               @db.VarChar(50)
  referenceId       String?               @db.VarChar(200)
  createdAt         DateTime              @default(now())

  @@unique([businessId, variantId, type, referenceType, referenceId], map: "InventoryMovement_operation_key")
  @@index([businessId, createdAt])
  @@index([productId, createdAt])
  @@index([businessId, variantId, createdAt])
  @@index([businessId, referenceType, referenceId])
}

model ImportJob {
  id            String           @id @default(uuid()) @db.Uuid
  businessId    String           @db.Uuid
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  status        ImportJobStatus  @default(UPLOADED)
  sourceType    ImportSourceType @default(EXCEL)
  fileName      String
  fileKey       String?
  sheetName     String?
  headerRow     Int?
  mapping       Json?            @db.JsonB
  errors        Json?            @db.JsonB
  totalRows     Int              @default(0)
  validRows     Int              @default(0)
  invalidRows   Int              @default(0)
  skippedRows   Int              @default(0)
  insertedCount Int              @default(0)
  updatedCount  Int              @default(0)
  failedCount   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
}

enum ConversationChannel {
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSenderType {
  CUSTOMER
  AI
  OWNER
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  OTHER
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  businessId    String         @db.Uuid
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// International format, digits only (WhatsApp wa_id style), e.g. 201000000001.
  phone         String         @db.VarChar(20)
  name          String?        @db.VarChar(200)
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([businessId, phone])
  // Lets Conversation reference (businessId, customerId) so both rows always share a business.
  @@unique([businessId, id])
  @@index([businessId, createdAt])
}

model Conversation {
  id                    String              @id @default(uuid()) @db.Uuid
  businessId            String              @db.Uuid
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerId            String              @db.Uuid
  customer              Customer            @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  channel               ConversationChannel @default(WHATSAPP)
  status                ConversationStatus  @default(OPEN)
  /// Human handoff: false = the owner took over and the AI stays silent.
  aiEnabled             Boolean             @default(true)
  handoffReason         String?             @db.VarChar(100)
  handoffAt             DateTime?
  lastMessageAt         DateTime?
  /// Last customer message; the owner may reply freely for 24 hours after it.
  lastCustomerMessageAt DateTime?
  messages              Message[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  /// MVP: one rolling conversation per customer per channel.
  @@unique([businessId, customerId, channel])
  @@unique([businessId, id])
  @@index([businessId, updatedAt])
  @@index([customerId])
}

model Message {
  id                String                @id @default(uuid()) @db.Uuid
  businessId        String                @db.Uuid
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversationId    String                @db.Uuid
  conversation      Conversation          @relation(fields: [businessId, conversationId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  senderType        MessageSenderType
  /// WhatsApp messages[].id (wamid...). Unique so a re-delivered webhook is stored once.
  externalMessageId String?               @unique @db.VarChar(255)
  content           String
  messageType       MessageType           @default(TEXT)
  status            MessageDeliveryStatus @default(RECEIVED)
  /// What the AI returned for AI messages: intent, orderCandidate, source…
  aiMeta            Json?                 @db.JsonB
  createdAt         DateTime              @default(now())

  @@index([businessId, conversationId, createdAt])
}

enum MessageDeliveryStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Which WhatsApp business number belongs to which business (MVP: one each way).
model WhatsAppConnection {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @unique @db.Uuid
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Meta's id for the business number (WhatsApp > API Setup), not the phone number itself.
  phoneNumberId String   @unique @db.VarChar(64)
  /// false = keep the link but ignore its webhooks and do not send from it.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}