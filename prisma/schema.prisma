generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(200)
  description        String?
  category           String?             @db.VarChar(200)
  phone              String?             @db.VarChar(50)
  address            String?             @db.VarChar(1000)
  settings           BusinessSettings?
  workingHours       WorkingHour[]
  catalogItems       CatalogItem[]
  importJobs         ImportJob[]
  inventoryMovements InventoryMovement[]
  customers          Customer[]
  conversations      Conversation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model BusinessSettings {
  businessId           String   @id @db.Uuid
  business             Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  acceptsCash          Boolean  @default(true)
  acceptsOnlinePayment Boolean  @default(false)
  deliveryEnabled      Boolean  @default(false)
  pickupEnabled        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model WorkingHour {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  dayOfWeek  DayOfWeek
  isOpen     Boolean
  opensAt    String?   @db.VarChar(5)
  closesAt   String?   @db.VarChar(5)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model CatalogItem {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  externalKey        String?             @db.VarChar(200)
  name               String              @db.VarChar(200)
  description        String?
  category           String?             @db.VarChar(200)
  basePrice          Decimal?            @db.Decimal(12, 2)
  trackInventory     Boolean             @default(false)
  stockQuantity      Int?
  attributes         Json?               @db.JsonB
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]

  @@unique([businessId, externalKey])
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, createdAt])
}

enum ImportJobStatus {
  UPLOADED
  ANALYZING
  MAPPING_REQUIRED
  VALIDATING
  READY
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ImportSourceType {
  EXCEL
}

enum InventoryMovementType {
  INITIAL_IMPORT
  IMPORT_UPDATE
  MANUAL_ADJUSTMENT
  ORDER_APPROVED
  ORDER_CANCELLED
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  businessId     String                @db.Uuid
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  catalogItemId  String                @db.Uuid
  catalogItem    CatalogItem           @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  type           InventoryMovementType
  quantityBefore Int?
  quantityAfter  Int
  quantityDelta  Int
  referenceType  String?               @db.VarChar(50)
  referenceId    String?               @db.VarChar(200)
  createdAt      DateTime              @default(now())

  @@index([businessId, createdAt])
  @@index([catalogItemId, createdAt])
  @@index([businessId, referenceType, referenceId])
}

model ImportJob {
  id            String           @id @default(uuid()) @db.Uuid
  businessId    String           @db.Uuid
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  status        ImportJobStatus  @default(UPLOADED)
  sourceType    ImportSourceType @default(EXCEL)
  fileName      String
  fileKey       String?
  sheetName     String?
  headerRow     Int?
  mapping       Json?            @db.JsonB
  errors        Json?            @db.JsonB
  totalRows     Int              @default(0)
  validRows     Int              @default(0)
  invalidRows   Int              @default(0)
  skippedRows   Int              @default(0)
  insertedCount Int              @default(0)
  updatedCount  Int              @default(0)
  failedCount   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
}

enum ConversationChannel {
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSenderType {
  CUSTOMER
  AI
  OWNER
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  OTHER
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  businessId    String         @db.Uuid
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// International format, digits only (WhatsApp wa_id style), e.g. 201000000001.
  phone         String         @db.VarChar(20)
  name          String?        @db.VarChar(200)
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([businessId, phone])
  @@index([businessId, createdAt])
}

model Conversation {
  id         String              @id @default(uuid()) @db.Uuid
  businessId String              @db.Uuid
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerId String              @db.Uuid
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  channel    ConversationChannel @default(WHATSAPP)
  status     ConversationStatus  @default(OPEN)
  messages   Message[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  /// MVP: one rolling conversation per customer per channel.
  @@unique([businessId, customerId, channel])
  @@index([businessId, updatedAt])
  @@index([customerId])
}

model Message {
  id                String            @id @default(uuid()) @db.Uuid
  conversationId    String            @db.Uuid
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderType        MessageSenderType
  /// WhatsApp messages[].id (wamid...). Unique so a re-delivered webhook is stored once.
  externalMessageId String?           @unique @db.VarChar(255)
  content           String
  messageType       MessageType       @default(TEXT)
  createdAt         DateTime          @default(now())

  @@index([conversationId, createdAt])
}
