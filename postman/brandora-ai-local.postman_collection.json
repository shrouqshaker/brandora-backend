{
  "info": {
    "name": "Brandora - Local AI / Real Backend (No Conversations)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Loopback-only runner. Start isolated PostgreSQL, dev/ai-local.cjs and standalone app.local first. No owner JWTs, service credentials or keys belong in this collection. See docs/ai-local-testing.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3099",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 - Product availability",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Brandora-Local-Test",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"عندكوا تيشيرت أسود؟\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/dev/ai/respond",
        "description": "Independent synthetic message. No credentials, persisted customer or saved history."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Exact read-only E0-3 contract\", function () {",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"intent\",\"orderCandidate\",\"reply\",\"requiresReview\"]);",
              "  pm.expect(body.orderCandidate).to.eql(null);",
              "});",
              "pm.test(\"Synthetic local mode is explicit\", function () {",
              "  pm.expect(pm.response.headers.get(\"X-Brandora-Test-Mode\")).to.eql(\"synthetic-no-history\");",
              "});"
            ]
          }
        }
      ]
    },
